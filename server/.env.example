# Copier en `server/.env` (jamais commité) puis adapter.

# Port d'écoute de l'API.
PORT=3001

# Fichier SQLite. `:memory:` pour une base jetable (tests).
DB_PATH=data/vault.db

# OBLIGATOIRE : 32 caractères minimum, secret de signature des cookies de session.
# En générer un : node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-moi-32-caracteres-minimum-svp

# Origine du client en développement (Vite). Absente = pas de CORS (le serveur
# sert lui-même le client en production).
CLIENT_URL=http://127.0.0.1:5173

# Cookie Secure : 1 pour forcer, 0 pour l'interdire (HTTP local).
# Par défaut : activé en production seulement.
COOKIE_SECURE=0

# production = client construit servi par Express, cookie Secure, pas de CORS.
NODE_ENV=development
