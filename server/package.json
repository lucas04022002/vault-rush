{
  "name": "vault-rush-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/app.ts",
    "dev": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env --watch src/app.ts",
    "test": "node --disable-warning=ExperimentalWarning --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^4.19.2",
    "hash-wasm": "^4.12.0",
    "helmet": "^8.0.0",
    "jose": "^5.9.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "typescript": "^5.5.3"
  }
}
