{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!docs",
      "!audit",
      "!**/package-lock.json"
    ]
  },
  "formatter": { "enabled": false },
  "assist": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "useSemanticElements": "off",
        "noNoninteractiveTabindex": "off"
      },
      "suspicious": {
        "noArrayIndexKey": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/tests/**"],
      "linter": {
        "rules": {
          "suspicious": { "noExplicitAny": "off", "noExportsInTest": "off" },
          "style": { "noNonNullAssertion": "off" }
        }
      }
    },
    {
      "includes": ["client/src/styles/**"],
      "linter": { "rules": { "complexity": { "noImportantStyles": "off" } } }
    },
    {
      "includes": ["client/src/lib/sound.ts"],
      "linter": { "rules": { "suspicious": { "useIterableCallbackReturn": "off" } } }
    }
  ]
}
